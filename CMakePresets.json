{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "container",
      "displayName": "Linux container (Docker dev image)",
      "generator": "Ninja",
      "binaryDir": "/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "RM_BUILD_RENDER": "ON",
        "RM_BUILD_UI": "ON"
      }
    },
    {
      "name": "pi",
      "displayName": "Raspberry Pi (native build)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "RM_BUILD_RENDER": "ON",
        "RM_BUILD_UI": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "container", "configurePreset": "container" },
    { "name": "pi", "configurePreset": "pi" }
  ],
  "testPresets": [
    {
      "name": "container",
      "configurePreset": "container",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "pi",
      "configurePreset": "pi",
      "output": { "outputOnFailure": true }
    }
  ]
}
